#include <SPI.h>
#include <MFRC522.h>

#define SS_PIN 10   // RFID module slave select pin
#define RST_PIN 9   // RFID module reset pin
#define LED_PIN 7   // LED to indicate misplacement

MFRC522 mfrc522(SS_PIN, RST_PIN);  // Create MFRC522 instance

// Example list of authorized book UIDs for this rack
byte authorizedBooks[][4] = {
  {0xDE, 0xAD, 0xBE, 0xEF},
  {0x12, 0x34, 0x56, 0x78},
  {0xAA, 0xBB, 0xCC, 0xDD}
};
const int authorizedCount = 3;

bool isAuthorized(byte *uid) {
  for (int i = 0; i < authorizedCount; i++) {
    bool match = true;
    for (int j = 0; j < 4; j++) {
      if (uid[j] != authorizedBooks[i][j]) {
        match = false;
        break;
      }
    }
    if (match) return true;
  }
  return false;
}

void setup() {
  Serial.begin(9600);
  SPI.begin();
  mfrc522.PCD_Init();
  pinMode(LED_PIN, OUTPUT);
  digitalWrite(LED_PIN, LOW); // LED off initially
  Serial.println("Library Book Rack Misplacement Detector Ready");
}

void loop() {
  // Look for new cards
  if (!mfrc522.PICC_IsNewCardPresent()) {
    digitalWrite(LED_PIN, LOW); // no book present, turn LED off
    return;
  }

  // Select one of the cards
  if (!mfrc522.PICC_ReadCardSerial()) {
    return;
  }

  // Show UID on serial
  Serial.print("Book UID: ");
  for (byte i = 0; i < mfrc522.uid.size; i++) {
    Serial.print(mfrc522.uid.uidByte[i], HEX);
    Serial.print(" ");
  }
  Serial.println();

  // Check if book belongs to this rack
  if (isAuthorized(mfrc522.uid.uidByte)) {
    Serial.println("Correct rack - LED off");
    digitalWrite(LED_PIN, LOW); // correct placement, LED off
  } else {
    Serial.println("Wrong rack - LED ON");
    digitalWrite(LED_PIN, HIGH); // wrong placement, light the LED
  }

  delay(2000);  // Wait 2 seconds before next scan
  mfrc522.PICC_HaltA();  // Halt the current card
}
